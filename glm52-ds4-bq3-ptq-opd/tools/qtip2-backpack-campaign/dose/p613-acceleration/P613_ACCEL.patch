 # ============================================== activation cache
+def batch_stable_layer(layer, hidden_states, *, position_embeddings,
+                       position_ids, attention_mask, input_ids,
+                       past_key_values):
+    """Batch the expensive invariant paths without changing batch-1 numerics.
+
+    DeepSeek-V4's attention and the packed routed-expert Triton kernels are
+    row-stable across batch sizes.  Its mHC projections, router/shared-expert
+    dense GEMMs, and residual batched matmuls are not: changing B changes the
+    GEMM algorithm and moves BF16 rows enough to alter repair decisions.  Keep
+    those shape-sensitive operations at their sealed B=1 shape while batching
+    attention and routed experts across all windows.  Concatenation preserves
+    autograd, so the same helper is valid for cache builds, scoring and train.
+    """
+    batch = int(hidden_states.shape[0])
+    if batch == 1:
+        return layer(
+            hidden_states, position_embeddings=position_embeddings,
+            position_ids=position_ids, attention_mask=attention_mask,
+            input_ids=input_ids, past_key_values=past_key_values,
+        )
+
+    dtype = hidden_states.dtype
+
+    def per_window(module, tensor):
+        rows = [module(tensor[index:index + 1]) for index in range(batch)]
+        if isinstance(rows[0], tuple):
+            return tuple(torch.cat([row[item] for row in rows], dim=0)
+                         for item in range(len(rows[0])))
+        return torch.cat(rows, dim=0)
+
+    post, comb, collapsed = per_window(layer.attn_hc, hidden_states)
+    attn_output, _ = layer.self_attn(
+        layer.input_layernorm(collapsed),
+        position_embeddings=position_embeddings,
+        position_ids=position_ids,
+        attention_mask=attention_mask,
+        past_key_values=past_key_values,
+    )
+    hidden_states = torch.cat([
+        post[index:index + 1].to(dtype).unsqueeze(-1)
+        * attn_output[index:index + 1].unsqueeze(-2)
+        + torch.matmul(
+            comb[index:index + 1].to(dtype).transpose(-1, -2),
+            hidden_states[index:index + 1],
+        )
+        for index in range(batch)
+    ], dim=0)
+
+    post, comb, collapsed = per_window(layer.ffn_hc, hidden_states)
+    normalized = layer.post_attention_layernorm(collapsed)
+    gate_rows = []
+    for index in range(batch):
+        row = normalized[index:index + 1]
+        if layer.mlp.is_hash:
+            gate_rows.append(layer.mlp.gate(
+                row, input_ids[index:index + 1]
+            ))
+        else:
+            gate_rows.append(layer.mlp.gate(row))
+    weights = torch.cat([row[1] for row in gate_rows], dim=0)
+    indices = torch.cat([row[2] for row in gate_rows], dim=0)
+    routed = layer.mlp.experts(
+        normalized.reshape(-1, normalized.shape[-1]), indices, weights
+    ).view_as(normalized)
+    shared = per_window(layer.mlp.shared_experts, normalized)
+    mlp_output = routed + shared
+    return torch.cat([
+        post[index:index + 1].to(dtype).unsqueeze(-1)
+        * mlp_output[index:index + 1].unsqueeze(-2)
+        + torch.matmul(
+            comb[index:index + 1].to(dtype).transpose(-1, -2),
+            hidden_states[index:index + 1],
+        )
+        for index in range(batch)
+    ], dim=0)
+
