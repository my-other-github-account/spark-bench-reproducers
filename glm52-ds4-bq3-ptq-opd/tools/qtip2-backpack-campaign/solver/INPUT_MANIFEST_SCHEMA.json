{
  "$id": "https://example.invalid/glm52/qtip2/input-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Schema for inputs/INPUT_MANIFEST.json. Data payloads are intentionally not published; each external file is represented only by repository-relative path, exact byte count, and SHA-256. Both solver lineages rehash every row before solve.",
  "properties": {
    "files": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "files"
  ],
  "runtime_contract": {
    "consumers": [
      "solver/p629/solve_global_ab.py",
      "solver/p637/solve_actual.py"
    ],
    "expected_input_manifest_sha256": "88ebfc21a7134088cad0a9a4f09821410db29ac13cd754d4d46f8902bebecb42",
    "payload_policy": "pointers plus byte counts and SHA-256 only; no weights, units, or teacher data bundled"
  },
  "title": "QTIP2 Backpack sealed solver input manifest",
  "type": "object"
}
