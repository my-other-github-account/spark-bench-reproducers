{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banana-smasher.dev/schema/bs-paired-real-axis-evaluation-v1.schema.json",
  "title": "banana-smasher paired real-axis evaluation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "operation", "evaluation_id", "evaluation_spec_sha256", "mode", "bank", "population", "instrument", "topology", "arms", "paired", "performance", "resume", "elapsed_seconds", "artifacts"],
  "properties": {
    "schema": {"const": "bs-paired-real-axis-evaluation-v1"},
    "schema_version": {"const": 1},
    "status": {"const": "COMPLETE"},
    "operation": {"const": "evaluate"},
    "evaluation_id": {"$ref": "#/$defs/sha256"},
    "evaluation_spec_sha256": {"$ref": "#/$defs/sha256"},
    "mode": {"const": "paired_real_axis"},
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bank_id", "manifest_sha256", "build_spec_sha256", "tree_sha256"],
      "properties": {
        "bank_id": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "build_spec_sha256": {"$ref": "#/$defs/sha256"},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_window_ids_sha256", "windows", "positions", "classes"],
      "properties": {
        "ordered_window_ids_sha256": {"$ref": "#/$defs/sha256"},
        "windows": {"type": "integer", "minimum": 1},
        "positions": {"type": "integer", "minimum": 1},
        "classes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "profile", "teacher_storage", "support", "cutoff", "direction", "attention", "estimator", "profile_sha256"],
      "properties": {
        "schema": {"const": "bs-real-axis-instrument-v1"},
        "schema_version": {"const": 1},
        "profile": {"type": "string", "minLength": 1},
        "teacher_storage": {"const": "top_support_logprob"},
        "support": {"type": "integer", "minimum": 1},
        "cutoff": {"type": "integer", "minimum": 1},
        "direction": {"const": "kl_teacher_candidate"},
        "attention": {"type": "string", "minLength": 1},
        "estimator": {"type": "string", "minLength": 1},
        "profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_count", "layers"],
      "properties": {
        "layer_count": {"type": "integer", "minimum": 1},
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layer", "candidate", "reference"],
            "properties": {
              "layer": {"type": "integer", "minimum": 0},
              "candidate": {"$ref": "#/$defs/layer_descriptor"},
              "reference": {"$ref": "#/$defs/layer_descriptor"}
            }
          }
        }
      }
    },
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "reference"],
      "properties": {
        "candidate": {"$ref": "#/$defs/arm", "required": ["artifact", "logits_manifest", "kld_manifest", "kld", "top1_parity", "per_window"]},
        "reference": {"$ref": "#/$defs/arm", "required": ["artifact", "logits_manifest", "kld_manifest", "kld", "top1_parity", "per_window"]}
      }
    },
    "paired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta_definition", "window_deltas", "mean_window_delta", "paired_ci95", "improvement_ratio_definition", "improvement_ratio"],
      "properties": {
        "delta_definition": {"const": "candidate window-mean KLD minus reference window-mean KLD"},
        "window_deltas": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "mean_window_delta": {"type": "number"},
        "paired_ci95": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
        "improvement_ratio_definition": {"const": "reference global KLD divided by candidate global KLD"},
        "improvement_ratio": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens_per_second", "wall_seconds", "peak_vram_bytes", "quality_result", "kernel", "fallback_used", "fallback_status", "window_batch_size", "layer_forwards_per_arm", "head_forwards_per_arm"],
      "properties": {
        "tokens_per_second": {"type": "number", "exclusiveMinimum": 0},
        "wall_seconds": {"type": "number", "exclusiveMinimum": 0},
        "peak_vram_bytes": {"const": 0},
        "quality_result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "candidate_global_kld", "reference_global_kld", "paired_mean_window_delta"],
          "properties": {
            "status": {"const": "PASS"},
            "candidate_global_kld": {"type": "number", "minimum": 0},
            "reference_global_kld": {"type": "number", "minimum": 0},
            "paired_mean_window_delta": {"type": "number"}
          }
        },
        "kernel": {"const": "numpy-concatenated-all-window-gemm"},
        "fallback_used": {"const": false},
        "fallback_status": {"const": "none"},
        "window_batch_size": {"type": "integer", "minimum": 1},
        "layer_forwards_per_arm": {"type": "integer", "minimum": 0},
        "head_forwards_per_arm": {"const": 1}
      }
    },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_from_layer", "checkpoint_sha256"],
      "properties": {
        "started_from_layer": {"type": "integer", "minimum": 0},
        "checkpoint_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "tree_sha256"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "members"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "members": {"type": "integer", "minimum": 1}
      }
    },
    "artifact_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "real_axis_manifest_sha256", "layer_count", "pack_manifest_sha256", "pack_instance_id"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "real_axis_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "layer_count": {"type": "integer", "minimum": 1},
        "pack_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "pack_instance_id": {"type": "string", "minLength": 1}
      }
    },
    "kld": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global", "per_class"],
      "properties": {
        "global": {"type": "number", "minimum": 0},
        "per_class": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0}}
      }
    },
    "top1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agreement_count", "positions", "rate", "per_class"],
      "properties": {
        "agreement_count": {"type": "integer", "minimum": 0},
        "positions": {"type": "integer", "minimum": 1},
        "rate": {"type": "number", "minimum": 0, "maximum": 1},
        "per_class": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/parity_row"}}
      }
    },
    "parity_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agreement_count", "positions", "rate"],
      "properties": {
        "agreement_count": {"type": "integer", "minimum": 0},
        "positions": {"type": "integer", "minimum": 1},
        "rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "per_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_id", "class", "positions", "mean_kld", "top1_agreement_count", "top1_rate"],
      "properties": {
        "window_id": {"type": ["string", "integer"]},
        "class": {"type": "string", "minLength": 1},
        "positions": {"type": "integer", "minimum": 1},
        "mean_kld": {"type": "number", "minimum": 0},
        "top1_agreement_count": {"type": "integer", "minimum": 0},
        "top1_rate": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "logits_manifest", "kld_manifest", "kld", "top1_parity", "per_window"],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact_identity"},
        "logits_manifest": {"$ref": "#/$defs/file_identity"},
        "kld_manifest": {"$ref": "#/$defs/file_identity"},
        "kld": {"$ref": "#/$defs/kld"},
        "top1_parity": {"$ref": "#/$defs/top1"},
        "per_window": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/per_window"}}
      }
    },
    "array_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "dtype", "shape"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "dtype": {"type": "string", "minLength": 2},
        "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "layer_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "activation", "descriptor", "weight", "bias", "sha256"],
      "properties": {
        "layer": {"type": "integer", "minimum": 0},
        "activation": {"enum": ["identity", "relu", "tanh"]},
        "descriptor": {"type": "object", "minProperties": 1},
        "weight": {"$ref": "#/$defs/array_descriptor"},
        "bias": {"oneOf": [{"$ref": "#/$defs/array_descriptor"}, {"type": "null"}]},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}