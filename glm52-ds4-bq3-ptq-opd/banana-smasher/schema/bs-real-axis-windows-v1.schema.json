{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banana-smasher.dev/schema/bs-real-axis-windows-v1.schema.json",
  "title": "banana-smasher ordered real-axis population",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "corpus_id", "windows"],
  "properties": {
    "schema": {"const": "bs-real-axis-windows-v1"},
    "schema_version": {"const": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["window_id", "class", "path", "bytes", "sha256", "dtype", "shape"],
        "properties": {
          "window_id": {"type": ["integer", "string"]},
          "class": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "dtype": {"type": "string", "minLength": 2},
          "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}
        }
      }
    }
  }
}
