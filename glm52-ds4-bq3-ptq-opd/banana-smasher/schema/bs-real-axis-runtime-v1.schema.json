{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banana-smasher.dev/schema/bs-real-axis-runtime-v1.schema.json",
  "title": "banana-smasher manifest-driven real-axis runtime",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "model_id", "layers", "head"],
  "properties": {
    "schema": {"const": "bs-real-axis-runtime-v1"},
    "schema_version": {"const": 1},
    "model_id": {"type": "string", "minLength": 1},
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/layer"}
    },
    "head": {"$ref": "#/$defs/projection"}
  },
  "$defs": {
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "dtype", "shape"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dtype": {"type": "string", "minLength": 2},
        "shape": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight"],
      "properties": {"weight": {"$ref": "#/$defs/tensor"}, "bias": {"$ref": "#/$defs/tensor"}}
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "activation", "descriptor", "weight"],
      "properties": {
        "layer": {"type": "integer", "minimum": 0},
        "activation": {"enum": ["identity", "relu", "tanh"]},
        "descriptor": {"type": "object"},
        "weight": {"$ref": "#/$defs/tensor"},
        "bias": {"$ref": "#/$defs/tensor"}
      }
    }
  }
}
