{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banana-smasher:vendor-index:v1",
  "title": "Vendored source and transformation index",
  "type": "object",
  "required": ["schema", "runtime_upstream_sha256", "evalplus", "capabilities", "files", "aggregate_sha256"],
  "properties": {
    "schema": {"const": "banana-smasher-vendor-index-v1"},
    "runtime_upstream_sha256": {"type": "object"},
    "evalplus": {"type": "object"},
    "capabilities": {"type": "object"},
    "aggregate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256", "source_sha256", "capability", "transformed"],
        "properties": {
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "capability": {"type": "string"},
          "transformed": {"type": "boolean"}
        }
      }
    }
  }
}
